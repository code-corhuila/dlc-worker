# Notifications schema as the runtime role (never the migrator); the worker runs no migrations
DB_URL=jdbc:postgresql://dlc-postgres:5432/di_lucca
DB_USERNAME=notifications_runtime
DB_PASSWORD=<notifications-runtime-password>

# RabbitMQ: the worker declares its own queue and DLQ on appointments.events. The URI carries credentials: keep it secret.
WORKER_RABBITMQ_URI=amqp://<user>:<password>@dlc-rabbitmq:5672
# APPOINTMENTS_EVENTS_EXCHANGE=appointments.events
# WORKER_CONSUMER_ATTEMPTS=5
# WORKER_CONSUMER_BACKOFF=PT1S

# Owner private contracts (/internal/v1). Short-lived service JWTs (sub dlc-worker) in one-line files,
# reread on every call; a credential provider renews them. Never a staff token.
APPOINTMENTS_INTERNAL_URL=http://<appointments-host>:8080
APPOINTMENTS_SERVICE_TOKEN_FILE=/run/secrets/worker-to-appointments
PATIENTS_INTERNAL_URL=http://<patients-host>:8080
PATIENTS_SERVICE_TOKEN_FILE=/run/secrets/worker-to-patients
# WORKER_OWNER_TIMEOUT=PT3S

# Email provider over SMTP. Mailpit (compose profile "mailpit"): SMTP_HOST=dlc-mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=<sender-address>
# SMTP_USERNAME=
# SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# WORKER_EMAIL_BACKOFF=PT2S

# Docker Compose (deploy/compose.yml): external network and the host folder mounted read-only at /run/secrets
# PLATFORM_NETWORK=platform
WORKER_SECRETS_DIR=<host-folder-with-service-tokens>

# Migration job (db/deploy/compose.migrate.yml)
DLC_ENVIRONMENT=dev
NOTIFICATIONS_MIGRATOR_PASSWORD_FILE=<host-file-with-the-migrator-password>

# Integration tests (empty: the database and broker tests are skipped)
TEST_DATABASE_URL=
TEST_RABBITMQ_URL=
